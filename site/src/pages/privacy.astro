---
import Layout from "../layouts/Layout.astro";
import Simple from "../components/Simple.astro";
import { DICT } from "../i18n";
const t = DICT.en;
---
<Layout lang="en" title={`${t.privacyTitle} · vaultsweep`} path="privacy/">
  <Simple lang="en" title={t.privacyTitle}>{t.privacy.map((p) => <p>{p}</p>)}</Simple>
</Layout>

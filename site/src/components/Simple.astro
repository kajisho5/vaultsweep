---
// プライバシー・404 などの短いページ
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { DICT, type Lang } from "../i18n";
interface Props { lang: Lang; title: string }
const { lang, title } = Astro.props;
const t = DICT[lang];
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const home = lang === "en" ? base : `${base}ja/`;
---
<header class="flex justify-center px-4 pt-6">
  <a href={home} class="press flex w-max items-center gap-2 rounded-full border border-line bg-card px-4 py-2 text-base font-semibold hover:bg-hover"><Logo size={20} />vaultsweep</a>
</header>
<main id="main" class="mx-auto w-full max-w-[680px] px-4 py-24">
  <h1 class="text-4xl font-semibold tracking-tight">{title}</h1>
  <div class="mt-8 flex flex-col gap-4 text-base text-ink2"><slot /></div>
  <a href={home} class="press mt-12 inline-flex items-center gap-2 rounded-lg border border-line2 bg-card px-3 py-2 text-base font-semibold hover:bg-hover"><Icon name="arrowLeft" />{t.back}</a>
</main>

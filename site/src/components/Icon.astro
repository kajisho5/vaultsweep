---
import { ICONS } from "../icons";
interface Props { name: string; size?: number; class?: string }
const { name, size = 20, class: cls } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" class={cls}>
  {(ICONS[name] ?? []).map((d) => <path d={d} />)}
</svg>
